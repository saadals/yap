    { "type": { "sel": "input[name=video-title]", "text": "Wayfolk: the group chat that plans itself" } },
    { "type": { "sel": "input[name=video-hook]", "text": "Our group chat has planned zero trips." } },
    { "shot": "studio-business-m-profile-add" },
    { "click": "Add to portfolio" },
    { "text": "is first in your portfolio" },
