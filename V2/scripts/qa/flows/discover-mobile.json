{
  "account": "layla",
  "theme": "dark",
  "width": 390,
  "height": 844,
  "mobile": true,
  "steps": [
    { "go": "/discover", "after": 4000 },
    { "text": "Find creators" },
    { "text": "Saved 2" },
    { "notText": "Best for" },
    { "shot": "discover-m-all" },
    { "click": "Testimonial" },
    { "text": "creators match" },
    { "eval": "location.search.includes('format=testimonial') ? 'ok' : setTimeout(() => { throw new Error('format not in URL: ' + location.search) })" },
    { "shot": "discover-m-filtered" },
    { "click": "Filters" },
    { "text": "Kind of creator" },
    { "shot": "discover-m-filters" },
    { "click": "Close" },

    { "click": "Nina Holt", "after": 3000 },
    { "text": "Order from Nina" },
    { "text": "From $160" },
    { "text": "Basic · 4-day delivery" },
    { "shot": "discover-m-profile" },
    { "click": "Premium" },
    { "text": "Four-video pack" },
    { "text": "Premium · 10-day delivery" },
    { "shot": "discover-m-profile-premium", "full": true },
    { "click": "Order from Nina", "after": 3000 },
    { "eval": "location.pathname.replace(/\\/$/, '').endsWith('/creators/ninatries/order') && location.search.includes('package=pk-nina-premium') ? 'ok' : setTimeout(() => { throw new Error('order URL wrong: ' + location.href) })" },

    { "go": "/creators/laylatalks", "after": 3500 },
    { "text": "This is your public profile" },
    { "text": "Your public profile" },
    { "text": "Edit profile" },
    { "notText": "Order from Layla" },
    { "text": "Reply publicly" },
    { "shot": "discover-m-own-profile" },

    { "go": "/discover/watch", "after": 4500 },
    { "text": "Order from" },
    { "text": "Share" },
    { "notText": "Order from Layla" },
    { "shot": "discover-m-watch" },
    { "eval": "(window.__first = new URLSearchParams(location.search).get('video'))" },
    { "swipe": "up", "sel": ".y-feed", "span": 0.9, "dt": 8, "after": 2000 },
    { "eval": "new URLSearchParams(location.search).get('video') !== window.__first ? 'moved to ' + location.search : setTimeout(() => { throw new Error('swipe up did not move: ' + location.search) })" },
    { "shot": "discover-m-watch-next" },
    { "swipe": "left", "sel": ".y-feed", "after": 3000 },
    { "eval": "location.pathname.includes('/creators/') ? 'profile ' + location.pathname : setTimeout(() => { throw new Error('swipe left did not open the profile: ' + location.href) })" },
    { "text": "Order from" },

    { "go": "/discover/watch?creator=laylatalks", "after": 4000 },
    { "text": "Layla's videos" },
    { "text": "Edit your profile" },
    { "shot": "discover-m-watch-own" }
  ]
}
